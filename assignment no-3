#include <iostream>
using namespace std;

class Employee
{
 public:
    
    int id;
    string name;
    float salaryperday;

 void display()
    {
        cout << "====Employee Details===="<< endl;
        cout << "Employee ID= "  <<id << endl;
        cout << "Employee Name= "<< name << endl;
        cout <<"Salary per day=  " <<salaryperday<<endl;
    }
};

int main()
{
    Employee E1;

    E1.id=1098;

    E1.name="Ganesh";

    E1.salaryperday=60000.0;

    E1.display();

    return 0;
}